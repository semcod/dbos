# Copy to .env and customize
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432

API_PORT=3000
BUS_PORT=4000
UI_PORT=5173
CDN_PORT=8080
WEBDAV_PORT=8090

# FUSE mount (Linux host with /dev/fuse). Use `docker compose --profile fuse up`.
VFS_HOST_MOUNT=./vfs-mount
WEBDAV_USER=admin
WEBDAV_PASS=admin

JWT_SECRET=devsecret-change-me

# sync-engine behaviour
SYNC_MODE=dev          # dev = bi-directional, prod = DB is read-only authority
MERGE_POLICY=lww       # lww (last-write-wins) | db-wins | fs-wins

# --- Protocol gateways (docker compose --profile protocols up) ---
FTP_PORT=2121
FTP_HOST=0.0.0.0
FTP_USER=admin
FTP_PASS=admin
FTP_PASV_MIN=30000
FTP_PASV_MAX=30100

IMAP_PORT=1143
IMAP_HOST=0.0.0.0
IMAP_USER=admin
IMAP_PASS=admin

POP3_PORT=1110
POP3_HOST=0.0.0.0
POP3_USER=admin
POP3_PASS=admin

SMTP_PORT=2525
SMTP_HOST=0.0.0.0

# --- Storage / database ---
DATABASE_URL=postgres://platform:platform@postgres:5432/platform
STORAGE_BACKEND=pg-primary
STORAGE_DRIVER=postgres
STORAGE_DSN=postgres://platform:platform@postgres:5432/platform
COMMAND_BUS_URL=http://command-bus:4000

# --- Storage mirroring (docker compose --profile mirrors up) ---
SQLITE_PATH=/mirror-data/platform.sqlite
MIRROR_POLL_SECONDS=3
# Declared per-backend in `storage_backends`; these are fallback envs for the
# sqlite/mysql adapters when DSN uses ${VAR} substitution.
# MYSQL_DSN=mysql://user:pass@host:3306/platform

# --- Runtime config (overridable via UI panel -> SQLite) ---
CONFIG_DB=/config-data/platform-config.sqlite

